@@ -0,0 +1,59 @@
+// Copyright (c) Tailscale Inc & AUTHORS
+// SPDX-License-Identifier: BSD-3-Clause
+
+package server
+
+import (
+	"context"
+	"encoding/json"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"testing"
+
+	"tailscale.com/client/local"
+	"tailscale.com/client/tailscale/apitype"
+	"tailscale.com/tailcfg"
+)
+
+func TestAuthorizeAllowedEmails(t *testing.T) {
+	// Fake LocalAPI: every caller is alice.
+	localAPI := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		json.NewEncoder(w).Encode(&apitype.WhoIsResponse{
+			Node:        &tailcfg.Node{ID: 1, Name: "laptop.test.ts.net."},
+			UserProfile: &tailcfg.UserProfile{ID: 1, LoginName: "alice@example.com"},
+		})
+	}))
+	defer localAPI.Close()
+	lc := &local.Client{Dial: func(ctx context.Context, _, _ string) (net.Conn, error) {
+		return (&net.Dialer{}).DialContext(ctx, "tcp", localAPI.Listener.Addr().String())
+	}}
+
+	for _, tt := range []struct {
+		name    string
+		allowed []string
+		want    int
+	}{
+		{"allowed user", []string{"bob@example.com", "alice@example.com"}, http.StatusFound},
+		{"other users only", []string{"bob@example.com"}, http.StatusForbidden},
+		{"no allowlist", nil, http.StatusForbidden},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			srv := setupTestServer(t, lc)
+			client := srv.funnelClients["test-client"]
+			client.RedirectURIs = []string{"https://rp.example.com/callback"}
+			client.AllowedEmails = tt.allowed
+
+			query := url.Values{"client_id": {"test-client"}, "redirect_uri": {"https://rp.example.com/callback"}}
+			req := httptest.NewRequest("GET", "/authorize?"+query.Encode(), nil)
+			req.RemoteAddr = "100.64.0.1:12345"
+			rr := httptest.NewRecorder()
+			srv.serveAuthorize(rr, req)
+
+			if rr.Code != tt.want {
+				t.Errorf("got status %d, want %d: %s", rr.Code, tt.want, rr.Body.String())
+			}
+		})
+	}
+}
