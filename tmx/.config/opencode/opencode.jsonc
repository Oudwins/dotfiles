{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol",
  // plugins
  // not sure what this one is
  // https://github.com/obra/superpowers/blob/main/docs/README.opencode.md
  // https://github.com/spoons-and-mirrors/subtask2
  // https://github.com/different-ai/opencode-scheduler
  "plugin": [
    // smart context management
    // https://github.com/Opencode-DCP/opencode-dynamic-context-pruning
    // "@tarquinen/opencode-dcp@latest",
    // Adds native web search
    "opencode-websearch-cited@1.2.0",
  ],
  "mcp": {
    "executor": {
      "enabled": true,
      "type": "local",
      "command": ["executor", "mcp"],
      "timeout": 60000,
    },
  },
  "lsp": {},
  "provider": {
    "openai": {
      "options": {
        // required for web search plugin
        "websearch_cited": {
          "model": "gpt-5.6-sol",
        },
      },
      "models": {
        "gpt-5.6-sol": {},
        "gpt-6-astra": {},
      },
    },
    // "vertex_anthropic": {
    //   "npm": "@ai-sdk/google-vertex/anthropic",
    //   "name": "Google Vertex Anthropic",
    //   "options": {
    //     "project": "eleven-vertex-internal",
    //     "location": "{env:VERTEX_LOCATION}",
    //   },
    //   "models": {},
    // },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1",
      },
      "models": {
        "qwen3:4b": {
          "name": "qwen3:4b",
          "tools": true,
        },
        "qwen3:8b": {
          "name": "qwen3:8b",
          "tools": true,
        },
        "qwen3-coder:30b": {
          "name": "qwen3-coder:30b",
          "tools": true,
        },
      },
    },
    "cc-proxy": {
      "npm": "@ai-sdk/anthropic",
      "name": "cc-proxy",
      "options": {
        "baseURL": "http://localhost:8317/v1",
        "apiKey": "local",
      },
      "models": {
        "claude-opus-4-8": { "name": "Claude Opus 4.8" },
        "claude-opus-5": { "name": "Claude Opus 5" },
        "claude-fable-5": { "name": "Claude Fable 5" },
      },
    },
    // "vibeproxy": {
    //   "npm": "@ai-sdk/openai-compatible",
    //   "name": "VibeProxy",
    //   "options": {
    //     "baseURL": "http://localhost:8317/v1",
    //   },
    //   "models": {
    //     "claude-opus-4-8": { "name": "Claude Opus 4.8" },
    //     "claude-fable-5": { "name": "Claude Fable 5" },
    //   },
    // },
  },
  "agent": {},
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
    },
    "doom_loop": "ask",
    "question": "deny",
    "external_directory": "allow",
  },
}
